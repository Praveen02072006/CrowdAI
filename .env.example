# ─── Backend Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your own values. Never commit .env.

# Database (PostgreSQL for production, SQLite for local dev)
DATABASE_URL='postgresql://neondb_owner:npg_TAZMBJDQ2ER9@ep-bold-silence-axf0x24b-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# JWT Authentication
JWT_SECRET=replace_with_your_jwt_secret
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# CORS - URL of your frontend
CLIENT_URL=http://localhost:5173

# AI Service URL
AI_SERVICE_URL=http://localhost:8001

# ─── Frontend Environment Variables ────────────────────────────────────────────
# These must be prefixed with VITE_ to be exposed to the browser
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
